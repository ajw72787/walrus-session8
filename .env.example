# Server-side Ollama connection settings. Do not expose these values to the browser.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Walrus Memory mainnet relayer configuration. Keep actual values in .env.local.
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# Household player selector. These values are server-only and must each be four digits.
PLAYER_AARON_PIN=
PLAYER_LEO_PIN=
PLAYER_HENRY_PIN=

# Server-only signing secret for the HTTP-only player-session cookie.
PLAYER_SESSION_SECRET=
